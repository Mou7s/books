{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "books",
  "account_id": "0f9c07148681eb05f3aec99ea1a15f72",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "books.mou7s.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/en",
      "/en/*",
      "/zh-cn",
      "/zh-cn/*",
      "/read/*",
      "/appendices/*",
      "/publication/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
